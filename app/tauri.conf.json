{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor JW",
  "version": "0.1.0",
  "identifier": "io.github.leitorjw",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Leitor JW", "width": 1456, "height": 860, "minWidth": 720, "minHeight": 500, "dragDropEnabled": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
