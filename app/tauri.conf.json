{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JW Library on Linux",
  "version": "0.7.0",
  "identifier": "io.github.leitorjw",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JW Library on Linux",
        "width": 1456,
        "height": 860,
        "minWidth": 720,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Leitor de publicações .jwpub para Linux",
    "longDescription": "Leitor de publicações .jwpub no estilo do JW Library: Biblioteca, Bíblia com notas de estudo, Reuniões, grifos, notas, etiquetas, marcadores e backup .jwlibrary. Funciona sem internet com os arquivos que você importar. Projeto da comunidade, não oficial.",
    "copyright": "Projeto da comunidade",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "text"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "mainBinaryName": "leitor-jw"
}